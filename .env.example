# EdgeDefense MCP Server Configuration
# Copy this file to .env and fill in the values you need

# =====================================================================
# Tunnel Configuration (for serve_forever.py)
# =====================================================================
EDGEDEFENSE_TUNNEL_HOSTNAME=mcp.edgedefenseai.com
EDGEDEFENSE_TUNNEL_ID=edgedefense-mcp

# =====================================================================
# OAuth with Passphrase (default browser sign-in)
# =====================================================================
# EDGEDEFENSE_PASSPHRASE=your-passphrase-here

# =====================================================================
# Google Sign-In (optional, can be used with or without passphrase)
# =====================================================================
# Create an OAuth client in Google Cloud Console:
# 1. Go to APIs & Services → Credentials → Create credentials → OAuth client ID
# 2. Application type: Web application
# 3. Add this exact redirect URI: https://mcp.edgedefenseai.com/auth/google/callback
# 4. Copy the client ID and secret below
#
# EDGEDEFENSE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# EDGEDEFENSE_GOOGLE_CLIENT_SECRET=your-client-secret
#
# When using serve_forever.py, specify allowed emails with --allow-email:
#   python scripts/serve_forever.py --hostname mcp.edgedefenseai.com --tunnel edgedefense-mcp \
#     --oauth --google-client-id "$EDGEDEFENSE_GOOGLE_CLIENT_ID" \
#     --google-client-secret "$EDGEDEFENSE_GOOGLE_CLIENT_SECRET" \
#     --allow-email user@example.com --allow-email another@example.com \
#     --no-passphrase

# =====================================================================
# Simple Token-based Auth (no OAuth)
# =====================================================================
# EDGEDEFENSE_TOKEN=your-secret-token-here
